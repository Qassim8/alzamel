# عنوان الموقع — بدونه يُستخدم نطاق Vercel الحالي
# غيّره فور شراء النطاق الرسمي (بلا شرطة مائلة في النهاية)
NEXT_PUBLIC_SITE_URL=https://alzamel.vercel.app

# مفتاح Web3Forms المجاني — احصل عليه من https://web3forms.com
# بدونه لا يُرسل نموذج التواصل ويظهر بديل واتساب
NEXT_PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# رمز تأكيد ملكية الموقع في Google Search Console (اختياري)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
